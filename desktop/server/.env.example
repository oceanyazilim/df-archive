NODE_ENV=development

APP_NAME=Ocean Distro Finder
APP_URL=http://127.0.0.1:3000
APP_SECRET=

# Set this to unlock the admin panel (UUID visibility, lookup history, the
# UUID/distributor header search). Anyone without it sees the app as a
# regular, read-only user — leave empty to disable admin sign-in entirely.
ADMIN_PASSWORD=

# Soundcharts
SOUNDCHARTS_ENABLED=true
SOUNDCHARTS_BASE_URL=https://customer.api.soundcharts.com
SOUNDCHARTS_TOKEN_URL=https://account.soundcharts.com/oauth/token
SOUNDCHARTS_CLIENT_ID=
SOUNDCHARTS_CLIENT_SECRET=
SOUNDCHARTS_TEAM_ID=fyapar-api

SOUNDCHARTS_USE_LEGACY_AUTH=false
SOUNDCHARTS_LEGACY_APP_ID=
SOUNDCHARTS_LEGACY_API_KEY=

SOUNDCHARTS_REQUEST_TIMEOUT_MS=15000
SOUNDCHARTS_MAX_RETRIES=3
SOUNDCHARTS_CACHE_TTL_SECONDS=900
SOUNDCHARTS_CONCURRENCY=5

# Spotify
SPOTIFY_API_ENABLED=true
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Local distributor mapping
UUID_MAPPING_PATH=json/uuid's.json

# Lookup system
LOOKUP_HISTORY_ENABLED=true
LOOKUP_HISTORY_MAX_ITEMS=100
LOOKUP_REQUEST_TIMEOUT_MS=30000
LOOKUP_MAX_BATCH_SIZE=100

# ─────────────────────────────────────────────────────────────────────────────
# BACKUP CREDENTIALS (automatic failover)
#
# Both providers rate-limit per application, and a single lockout can last
# hours. Add spare keys as numbered slots and the app rotates to the next one
# the moment a key is throttled (429) or rejected (401/403). Slot 1 is the
# unsuffixed pair above, so nothing needs to change for an existing setup.
#
# Fill in as many as you have — empty slots are ignored, never an error.
# Check Settings → API Credentials in the panel to see which slots are live.

# Spotify apps (Developer Dashboard → Create app → Client ID / Secret)
SPOTIFY_CLIENT_ID_2=
SPOTIFY_CLIENT_SECRET_2=
SPOTIFY_CLIENT_ID_3=
SPOTIFY_CLIENT_SECRET_3=
SPOTIFY_CLIENT_ID_4=
SPOTIFY_CLIENT_SECRET_4=

# Soundcharts accounts. Each slot has a MODERN OAuth pair (client id + secret,
# optional per-slot team id) and, separately, the LEGACY header pair (app id +
# api key). The two are never mixed: modern endpoints get OAuth, legacy
# endpoints get the legacy pair. A missing legacy pair only marks legacy as
# unavailable for that slot — the modern credential keeps working.
# SOUNDCHARTS_LEGACY_TOKEN_n is accepted as an alias for _LEGACY_API_KEY_n.
SOUNDCHARTS_TEAM_ID_2=
SOUNDCHARTS_CLIENT_ID_2=
SOUNDCHARTS_CLIENT_SECRET_2=
SOUNDCHARTS_LEGACY_APP_ID_2=
SOUNDCHARTS_LEGACY_API_KEY_2=

SOUNDCHARTS_TEAM_ID_3=
SOUNDCHARTS_CLIENT_ID_3=
SOUNDCHARTS_CLIENT_SECRET_3=
SOUNDCHARTS_LEGACY_APP_ID_3=
SOUNDCHARTS_LEGACY_API_KEY_3=

SOUNDCHARTS_TEAM_ID_4=
SOUNDCHARTS_CLIENT_ID_4=
SOUNDCHARTS_CLIENT_SECRET_4=
SOUNDCHARTS_LEGACY_APP_ID_4=
SOUNDCHARTS_LEGACY_API_KEY_4=

SOUNDCHARTS_TEAM_ID_5=
SOUNDCHARTS_CLIENT_ID_5=
SOUNDCHARTS_CLIENT_SECRET_5=
SOUNDCHARTS_LEGACY_APP_ID_5=
SOUNDCHARTS_LEGACY_API_KEY_5=

# Pace outgoing Spotify calls (per process). Lower it if you still see 429s.
SPOTIFY_MAX_REQUESTS_PER_MINUTE=90
