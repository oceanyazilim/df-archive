# Virus Records license panel — required configuration.
# In Dokploy set these under the application's Environment tab.

# The password you sign in to the panel with.
PANEL_PASSWORD=

# Signs the admin session cookie. At least 16 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PANEL_SECRET=

# Where keys.json + events.jsonl live. Must be a mounted volume in production.
DATA_DIR=/data
